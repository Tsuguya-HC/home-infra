{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Rebase whenever the branch falls behind main. The default only rebases
  // automerge candidates, so a PR a human merges would sit on a stale main and
  // report CI results from a workflow that no longer exists there.
  "rebaseWhen": "behind-base-branch",


  // The aqua preset is pinned rather than floating: it owns which files the aqua
  // manager reads, and a preset-side change would silently re-scope this repo.
  "extends": [
    // config:best-practices = config:recommended + docker:pinDigests
    // + helpers:pinGitHubActionDigests + :configMigration + :pinDevDependencies
    // + abandonments:recommended + security:minimumReleaseAgeNpm
    // + :maintainLockFilesWeekly. The two presets listed separately before are
    // both inside it now.
    "config:best-practices",
    "github>aquaproj/aqua-renovate-config#2.13.0"
  ],

  // Baseline soak. Nothing here reaches the cluster without `make apply`, but a
  // Talos or Kubernetes bump is a node reboot, so it soaks like everything else.
  "minimumReleaseAge": "3 days",

  "customManagers": [
    {
      // talhelper's own keys — no manager reads talconfig.yaml, so both the Talos
      // and Kubernetes versions would be unmaintained pins without these two.
      "customType": "regex",
      "managerFilePatterns": ["/talconfig\\.yaml$/"],
      "matchStrings": [
        "talosVersion:\\s*(?<currentValue>v[\\d.]+)"
      ],
      // Tracked through our own installer image, which is the custom Talos build
      // this repo actually boots — not the upstream siderolabs release.
      "depNameTemplate": "ghcr.io/tsuguya/installer",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/talconfig\\.yaml$/"],
      "matchStrings": [
        "kubernetesVersion:\\s*(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": [
        "zizmor's version input, pinned so the action resolves a digest-pinned",
        "container instead of `latest`. Every other CLI in the workflows comes from",
        "aqua.yaml now, which the aqua preset handles. extractVersionTemplate drops",
        "the tag's leading v to match how the version is written in the file."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[\\w-]+: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],

  "packageRules": [
    {
      "description": [
        "The regex-managed deps live in lines that have nowhere to hold a digest",
        "(talconfig's `talosVersion: vX.Y.Z` feeds talhelper, which takes a bare",
        "version). docker:pinDigests still proposes a pinDigest update for them,",
        "the write fails, and the grouped renovate/pin-dependencies branch dies",
        "with `Error updating branch: update failure`, taking the docker-compose",
        "pins down with it."
      ],
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    },
    {
      "description": [
        "First-party code does not soak. minimumReleaseAge buys time for someone",
        "else to notice a poisoned release before we take it; there is no someone",
        "else here — we wrote it, reviewed it and merged it. Waiting three days on",
        "our own reusable workflow only delays fixes to the thing that gates every",
        "other check."
      ],
      "matchPackageNames": ["Tsuguya-HC/**"],
      "minimumReleaseAge": "0"
    },
    {
      "description": [
        "A digest has no release date attached (renovate#38656), so the age gate",
        "cannot be evaluated and renovate/stability-days is set but never clears.",
        "horenso#22 — a plain node:22-alpine digest pin — sat pending on exactly",
        "this for 84 days. digest-cooldown gates these on its own clock instead."
      ],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAge": "0"
    },
    {
      // Talos patch releases are bug fixes within a minor; the reboot still only
      // happens when a human runs `make apply`.
      "matchPackageNames": ["ghcr.io/tsuguya/installer"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Pin claude-code-action until anthropics/claude-code-action#1260 lands (Issue #1242)",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["anthropics/claude-code-action"],
      "allowedVersions": "<=1.0.99"
    },
    {
      "description": [
        "Leave the reusable-workflow ref in claude-review.yml alone. It points at",
        "@main deliberately: claude-code-action validates its entry-point workflow",
        "against the default branch, so any PR that edits that caller cannot be",
        "reviewed. Pinning it to a SHA would put it back in this bot's path on every",
        "change to the reusable body — exactly the failure the split removes."
      ],
      "matchManagers": ["github-actions"],
      "matchDepNames": ["Tsuguya-HC/home-infra"],
      "enabled": false
    }
  ]
}
