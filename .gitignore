# Generated configs (recreate with: talhelper genconfig)
clusterconfig/

# Plain-text secrets (should always be encrypted)
talsecret.yaml

# PXE boot assets (download with: make pxe-assets)
pxe/assets/

# PXE machine configs (contain secrets, generate with: make pxe-sync-configs)
pxe/config/

# Claude Code の worktree。リポジトリ内に作られるので、git add -A で
# gitlink としてステージされる事故を防ぐ。
.claude/worktrees/
